{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Irrigation System Configuration",
  "description": "Configuration schema for the irrigation control system",
  "type": "object",
  "required": ["timezone", "max_concurrent_valves", "location", "mqtt", "telemetry", "alerts", "valves"],
  "properties": {
    "timezone": {
      "type": "string",
      "description": "Timezone identifier (e.g., 'Asia/Jerusalem')",
      "minLength": 1
    },
    "max_concurrent_valves": {
      "type": "integer",
      "description": "Maximum number of valves that can run simultaneously",
      "minimum": 1
    },
    "flow_sensor_pin": {
      "type": "integer",
      "description": "GPIO pin for flow sensor",
      "minimum": 0
    },
    "location": {
      "type": "object",
      "description": "Geographic location",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    },
    "mqtt": {
      "type": "object",
      "description": "MQTT broker configuration",
      "required": ["enabled", "hostname", "client_name"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "client_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "description": "Telemetry reporting configuration",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "idle_interval": {
          "type": "number",
          "minimum": 0,
          "description": "Telemetry interval when idle (minutes); zero reports on every eligible loop"
        },
        "active_interval": {
          "type": "number",
          "minimum": 0,
          "description": "Telemetry interval when active (minutes); zero reports on every eligible loop"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"enabled": {"const": true}}
          },
          "then": {
            "required": ["idle_interval", "active_interval"]
          }
        }
      ],
      "additionalProperties": false
    },
    "sensors": {
      "type": "array",
      "description": "Weather/environmental sensors",
      "default": [],
      "items": {
        "type": "object",
        "required": ["type", "name", "enabled"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["openweathermap", "test"],
            "description": "The test type requires an explicitly injected sensor factory"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "api_key": {
            "type": "string",
            "minLength": 1
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "precipitation": {
            "type": "object",
            "default": {"days_to_aggregate": 3, "disable_threshold_mm": 1.0},
            "properties": {
              "days_to_aggregate": {
                "type": "integer",
                "minimum": 0,
                "default": 3
              },
              "disable_threshold_mm": {
                "type": "number",
                "minimum": 0,
                "default": 1.0
              }
            },
            "additionalProperties": false
          },
          "uv_adjustments": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "required": ["max_uv_index", "multiplier"],
              "properties": {
                "max_uv_index": {
                  "type": "number",
                  "minimum": 0
                },
                "multiplier": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Zero suppresses UV-adjusted scheduling. Positive multipliers must produce finite, timedelta-representable durations for every referencing UV-enabled schedule."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "if": {
          "properties": {"type": {"const": "openweathermap"}}
        },
        "then": {
          "required": ["api_key", "latitude", "longitude"]
        }
      }
    },
    "waterflow": {
      "type": "object",
      "description": "Water flow monitoring configuration",
      "required": ["type", "enabled", "leakdetection"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["mqtt", "test"],
          "description": "GPIO flow monitoring is not implemented; test requires an explicitly injected factory"
        },
        "enabled": {
          "type": "boolean"
        },
        "leakdetection": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "clientname": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {"type": {"const": "mqtt"}}
      },
      "then": {
        "required": ["hostname", "clientname", "topic"]
      },
      "additionalProperties": false
    },
    "alerts": {
      "type": "object",
      "description": "Alert configuration",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "object",
          "default": {},
          "properties": {
            "leak": {"type": "boolean", "default": true},
            "malfunction_no_flow": {"type": "boolean", "default": true},
            "irregular_flow": {"type": "boolean", "default": true},
            "sensor_error": {"type": "boolean", "default": true},
            "system_exit": {"type": "boolean", "default": true},
            "safety_intervention": {
              "type": "boolean",
              "default": true,
              "description": "Enable critical safety intervention alerts"
            },
            "actuation_failure": {
              "type": "boolean",
              "default": true,
              "description": "Enable critical valve actuation failure alerts"
            },
            "monitoring_unavailable": {
              "type": "boolean",
              "default": true,
              "description": "Enable warning alerts when monitoring is unavailable"
            }
          },
          "additionalProperties": false
        },
        "leak_repeat_minutes": {
          "type": "number",
          "minimum": 0,
          "default": 15
        },
        "irregular_flow_threshold": {
          "type": "number",
          "minimum": 0,
          "default": 2.0
        },
        "valve_overrides": {
          "type": "object",
          "description": "Per-valve alert settings, keyed by an existing valve name",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "irregular_flow_threshold": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "channels": {
          "type": "array",
          "description": "Alert notification channels",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["millerbot"]
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "user_id": {
                "type": "integer"
              },
              "api_key": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            },
            "if": {
              "properties": {"type": {"const": "millerbot"}}
            },
            "then": {
              "required": ["url", "user_id", "api_key", "role"]
            },
            "additionalProperties": false
          }
        },
        "leak_detection_exclusions": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": ["time_based_on", "duration"],
            "properties": {
              "time_based_on": {
                "type": "string",
                "enum": ["fixed", "sunrise", "sunset"]
              },
              "fixed_start_time": {
                "type": "string",
                "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"
              },
              "offset_minutes": {
                "type": "integer"
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Finite positive duration in minutes, including fractional minutes, representable by datetime.timedelta; no implicit default"
              },
              "days": {
                "type": "array",
                "default": [],
                "items": {
                  "type": "string",
                  "enum": ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
                }
              },
              "seasons": {
                "type": "array",
                "default": [],
                "items": {
                  "type": "string",
                  "enum": ["Spring", "Summer", "Fall", "Winter"]
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {"time_based_on": {"const": "fixed"}}
                },
                "then": {
                  "required": ["fixed_start_time"]
                }
              },
              {
                "if": {
                  "properties": {"time_based_on": {"enum": ["sunrise", "sunset"]}}
                },
                "then": {
                  "required": ["offset_minutes"]
                }
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "valves": {
      "type": "array",
      "description": "Irrigation valve configurations",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "enabled", "type", "watering_mode", "schedules"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "type": {
            "type": "string",
            "enum": ["3wire", "test"],
            "description": "2-wire valves are not implemented; test requires an explicitly injected factory"
          },
          "gpio_on_pin": {
            "type": "integer",
            "minimum": 0
          },
          "gpio_off_pin": {
            "type": "integer",
            "minimum": 0
          },
          "pulse_duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Positive pulse duration in seconds; the 3-wire driver limits pulses to 200 ms"
          },
          "watering_mode": {
            "type": "string",
            "enum": ["duration"],
            "description": "Volume-based watering is not implemented"
          },
          "sensor": {
            "type": "string",
            "minLength": 1
          },
          "schedules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["time_based_on", "duration"],
              "properties": {
                "time_based_on": {
                  "type": "string",
                  "enum": ["fixed", "sunrise", "sunset"]
                },
                "fixed_start_time": {
                  "type": "string",
                  "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$",
                  "description": "Time in H:MM or HH:MM format"
                },
                "offset_minutes": {
                  "type": "integer",
                  "description": "Offset from sunrise/sunset in minutes"
                },
                "duration": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Finite positive duration in minutes, including fractional minutes, representable by datetime.timedelta; no 30-minute schedule cap"
                },
                "days": {
                  "type": "array",
                  "default": [],
                  "items": {
                    "type": "string",
                    "enum": ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
                  }
                },
                "seasons": {
                  "type": "array",
                  "default": [],
                  "items": {
                    "type": "string",
                    "enum": ["Spring", "Summer", "Fall", "Winter"]
                  }
                },
                "enable_uv_adjustments": {
                  "type": "boolean",
                  "default": false
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {"time_based_on": {"const": "fixed"}}
                  },
                  "then": {
                    "required": ["fixed_start_time"]
                  }
                },
                {
                  "if": {
                    "properties": {"time_based_on": {"enum": ["sunrise", "sunset"]}}
                  },
                  "then": {
                    "required": ["offset_minutes"]
                  }
                }
              ],
              "additionalProperties": false
            }
          }
        },
        "if": {
          "properties": {"type": {"const": "3wire"}}
        },
        "then": {
          "required": ["gpio_on_pin", "gpio_off_pin"]
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
